<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Edit Mata Kuliah</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="main-content">
        <div class="container">
            <div class="page-header">
                <div class="title-wrap">
                    <h1>Edit Mata Kuliah</h1>
                    <div class="subtle">Perbarui data mata kuliah, lalu simpan perubahan.</div>
                </div>
                <div class="header-actions" style="margin: 0;">
                    <a href="/mk-postgres" class="home-link">Kembali</a>
                </div>
            </div>

            <div class="form-card">
                <form action="/edit-mk/<%= mk.kode_mk %>" method="POST">
                    <div class="form-grid">
                        <div>
                            <label for="kode_mk">Kode Mata Kuliah</label>
                            <input type="text" id="kode_mk" name="kode_mk" value="<%= mk.kode_mk %>" disabled>
                        </div>

                        <div>
                            <label for="sks">SKS</label>
                            <input type="number" id="sks" name="sks" value="<%= mk.sks %>" required min="1">
                        </div>

                        <div class="full">
                            <label for="nama_mk">Nama Mata Kuliah</label>
                            <input type="text" id="nama_mk" name="nama_mk" value="<%= mk.nama_mk %>" required maxlength="100">
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/mk-postgres" class="home-link">Batal</a>
                        <button type="submit" class="form-submit-btn">Simpan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>