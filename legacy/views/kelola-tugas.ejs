<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .nav-tabs {
            display: flex;
            border-bottom: 1px solid #cccccc;
            margin-bottom: 20px;
        }
        .nav-tabs a {
            padding: 10px 15px;
            text-decoration: none;
            color: #666666;
            border-bottom: 2px solid transparent;
            font-weight: bold;
        }
        .nav-tabs a:hover {
            color: #007bff;
        }
        .nav-tabs a.active {
            color: #007bff;
            border-bottom-color: #007bff;
        }
        .assignment-card {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 15px;
        }
        .assignment-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
        }
        .assignment-title {
            font-size: 1.2em;
            font-weight: bold;
            color: #333;
            margin: 0;
        }
        .assignment-meta {
            color: #666;
            font-size: 0.9em;
        }
        .assignment-meta span {
            margin-right: 15px;
        }
        .assignment-description {
            color: #555;
            margin: 10px 0;
            line-height: 1.5;
        }
        .assignment-actions {
            margin-top: 15px;
            display: flex;
            gap: 10px;
        }
        .btn-primary, .btn-secondary, .btn-danger {
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            text-decoration: none;
            font-weight: bold;
            cursor: pointer;
            display: inline-block;
        }
        .btn-primary { background: #007bff; color: white; }
        .btn-primary:hover { background: #0056b3; }
        .btn-secondary { background: #6c757d; color: white; }
        .btn-secondary:hover { background: #545b62; }
        .btn-danger { background: #dc3545; color: white; }
        .btn-danger:hover { background: #c82333; }
        .deadline-warning {
            color: #dc3545;
            font-weight: bold;
        }
        .deadline-normal {
            color: #666;
        }
    </style>
</head>
<body>
    <div class="main-content">
        <div class="container">
            <div class="nav-tabs">
                <a href="/" class="<%= activeTab === 'dashboard' ? 'active' : '' %>">Dashboard</a>
                <a href="/mk-postgres" class="<%= activeTab === 'mata-kuliah' ? 'active' : '' %>">Mata Kuliah</a>
                <a href="/mahasiswa-crud" class="<%= activeTab === 'mahasiswa' ? 'active' : '' %>">Mahasiswa</a>
                <a href="/mata-kuliah-view" class="<%= activeTab === 'absensi' ? 'active' : '' %>">Absensi</a>
                <a href="/kelola-nilai" class="<%= activeTab === 'nilai' ? 'active' : '' %>">Kelola Nilai</a>
                <a href="/transkrip" class="<%= activeTab === 'transkrip' ? 'active' : '' %>">Transkrip Nilai</a>
                <a href="/perpustakaan" class="<%= activeTab === 'perpustakaan' ? 'active' : '' %>">Perpustakaan</a>
                <a href="/jadwal" class="<%= activeTab === 'jadwal' ? 'active' : '' %>">Jadwal Kuliah</a>
                <a href="/tugas" class="active">Tugas</a>
            </div>

            <h1><i style="font-style: normal;">📝</i> <%= title %></h1>

            <div class="header-actions">
                <a href="/" class="home-link">Home</a>
                <a href="/tambah-tugas" class="tambah-link">Tambah Tugas Baru</a>
                <a href="/tugas" class="warning-link">Lihat Semua Tugas</a>
            </div>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Judul Tugas</th>
                            <th>Mata Kuliah</th>
                            <th>Deadline</th>
                            <th>Status</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% tugasData.forEach(function(tugas) { %>
                            <tr>
                                <td style="text-align: left;"><%= tugas.judul %></td>
                                <td><%= tugas.nama_mk %></td>
                                <td class="<%= new Date(tugas.deadline) < new Date() ? 'deadline-warning' : 'deadline-normal' %>">
                                    <%= new Date(tugas.deadline).toLocaleDateString('id-ID') %>
                                </td>
                                <td>
                                    <%= new Date(tugas.deadline) < new Date() ? 'Kadaluarsa' : 'Aktif' %>
                                </td>
                                <td class="actions">
                                    <a href="/tugas/<%= tugas.id %>" class="edit-btn">Lihat</a>
                                    <a href="/edit-tugas/<%= tugas.id %>" class="edit-btn">Edit</a>
                                    <form action="/hapus-tugas/<%= tugas.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Yakin ingin menghapus tugas <%= tugas.judul %>?');">
                                        <input type="hidden" name="_method" value="DELETE">
                                        <button type="submit" class="delete-btn">Hapus</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <% if (tugasData.length === 0) { %>
                <p style="text-align: center; padding: 20px; color: #666;">Belum ada tugas yang dibuat.</p>
            <% } %>
        </div>
    </div>
</body>
</html>