<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .nav-tabs {
            display: flex;
            border-bottom: 1px solid #cccccc;
            margin-bottom: 20px;
        }
        .nav-tabs a {
            padding: 10px 15px;
            text-decoration: none;
            color: #666666;
            border-bottom: 2px solid transparent;
            font-weight: bold;
        }
        .nav-tabs a:hover {
            color: #007bff;
        }
        .nav-tabs a.active {
            color: #007bff;
            border-bottom-color: #007bff;
        }
        .library-section {
            margin-bottom: 30px;
        }
        .book-card {
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 15px;
            margin-bottom: 10px;
            background: #f9f9f9;
        }
        .book-title {
            font-weight: bold;
            color: #007bff;
        }
        .book-info {
            font-size: 0.9em;
            color: #666;
        }
        .availability {
            font-weight: bold;
            color: #28a745;
        }
        .availability.unavailable {
            color: #dc3545;
        }
    </style>
</head>
<body>
    <div class="main-content">
        <div class="container">
            <div class="nav-tabs">
                <a href="/" class="<%= activeTab === 'dashboard' ? 'active' : '' %>">Dashboard</a>
                <a href="/mk-postgres" class="<%= activeTab === 'mata-kuliah' ? 'active' : '' %>">Mata Kuliah</a>
                <a href="/mahasiswa-crud" class="<%= activeTab === 'mahasiswa' ? 'active' : '' %>">Mahasiswa</a>
                <a href="/mata-kuliah-view" class="<%= activeTab === 'absensi' ? 'active' : '' %>">Absensi</a>
                <a href="/kelola-nilai" class="<%= activeTab === 'nilai' ? 'active' : '' %>">Kelola Nilai</a>
                <a href="/transkrip" class="<%= activeTab === 'transkrip' ? 'active' : '' %>">Transkrip Nilai</a>
                <a href="/perpustakaan" class="<%= activeTab === 'perpustakaan' ? 'active' : '' %>">Perpustakaan</a>
                <a href="/jadwal" class="<%= activeTab === 'jadwal' ? 'active' : '' %>">Jadwal Kuliah</a>
                <a href="/tugas" class="<%= activeTab === 'tugas' ? 'active' : '' %>">Tugas</a>
            </div>

            <h1><i style="font-style: normal;">📚</i> <%= title %></h1>

            <div class="library-section">
                <h2>Daftar Buku Tersedia</h2>
                <% if (daftarBuku && daftarBuku.length > 0) { %>
                    <% daftarBuku.forEach(buku => { %>
                        <div class="book-card">
                            <div class="book-title"><%= buku.judul %></div>
                            <div class="book-info">
                                <strong>Pengarang:</strong> <%= buku.pengarang || 'Tidak diketahui' %> |
                                <strong>Penerbit:</strong> <%= buku.penerbit || 'Tidak diketahui' %> |
                                <strong>Tahun:</strong> <%= buku.tahun_terbit || 'Tidak diketahui' %>
                            </div>
                            <div class="availability <%= buku.tersedia > 0 ? '' : 'unavailable' %>">
                                <%= buku.tersedia > 0 ? `Tersedia (${buku.tersedia})` : 'Tidak tersedia' %>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>Belum ada data buku di perpustakaan.</p>
                <% } %>
            </div>

            <% if (peminjamanAktif && peminjamanAktif.length > 0) { %>
                <div class="library-section">
                    <h2>Buku yang Sedang Dipinjam</h2>
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>Judul Buku</th>
                                    <th>Tanggal Pinjam</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% peminjamanAktif.forEach(pinjam => { %>
                                    <tr>
                                        <td><%= pinjam.judul %></td>
                                        <td><%= new Date(pinjam.tanggal_pinjam).toLocaleDateString('id-ID') %></td>
                                        <td><%= pinjam.status %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>