<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1><i style="font-style: normal;">📚</i> <%= title %></h1>
        
        <div class="header-actions">
            <a href="/" class="home-link">Home</a>
            <a href="/mahasiswa-crud" class="tambah-link" style="background-color: #ffc107; color: #333;">Kelola Mahasiswa</a> 
            <a href="/tambah-mk" class="tambah-link">Tambah Mata Kuliah Baru</a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Kode MK</th>
                    <th>Nama Mata Kuliah</th>
                    <th>SKS</th>
                    <th>CRUD Data</th>
                    <th>Absensi & Rekap</th>
                </tr>
            </thead>
            <tbody>
                <% listMk.forEach(function(mk) { %>
                    <tr>
                        <td><%= mk.kode_mk %></td>
                        <td><%= mk.nama_mk %></td>
                        <td><%= mk.sks %></td>
                        
                        <td class="actions">
                            <a href="/edit-mk/<%= mk.kode_mk %>" class="edit-btn">Edit</a>
                            
                            <form action="/hapus-mk/<%= mk.kode_mk %>" method="POST" style="display:inline;" onsubmit="return confirm('Yakin ingin menghapus <%= mk.nama_mk %>? Tindakan ini akan menghapus data absensi terkait.');">
                                <input type="hidden" name="_method" value="DELETE">
                                <button type="submit" class="delete-btn">Hapus</button>
                            </form>
                        </td>

                        <td class="actions">
                            <a href="/kelola-pertemuan/<%= mk.kode_mk %>" class="absen-btn">Kelola Pertemuan</a>
                            
                            <a href="/rekap-absen/<%= mk.kode_mk %>" class="rekap-btn">Lihat Rekap</a>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</body>
</html>