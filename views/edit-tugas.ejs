<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .nav-tabs {
            display: flex;
            border-bottom: 1px solid #cccccc;
            margin-bottom: 20px;
        }
        .nav-tabs a {
            padding: 10px 15px;
            text-decoration: none;
            color: #666666;
            border-bottom: 2px solid transparent;
            font-weight: bold;
        }
        .nav-tabs a:hover {
            color: #007bff;
        }
        .nav-tabs a.active {
            color: #007bff;
            border-bottom-color: #007bff;
        }
        .form-container {
            max-width: 600px;
            margin: 0 auto;
            background: #f8f9fa;
            padding: 20px;
            border-radius: 4px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 14px;
            box-sizing: border-box;
        }
        .form-group textarea {
            min-height: 120px;
            resize: vertical;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            border-color: #007bff;
            outline: none;
        }
    </style>
</head>
<body>
    <div class="main-content">
        <div class="container">
            <div class="nav-tabs">
                <a href="/" class="<%= activeTab === 'dashboard' ? 'active' : '' %>">Dashboard</a>
                <a href="/mk-postgres" class="<%= activeTab === 'mata-kuliah' ? 'active' : '' %>">Mata Kuliah</a>
                <a href="/mahasiswa-crud" class="<%= activeTab === 'mahasiswa' ? 'active' : '' %>">Mahasiswa</a>
                <a href="/mata-kuliah-view" class="<%= activeTab === 'absensi' ? 'active' : '' %>">Absensi</a>
                <a href="/kelola-nilai" class="<%= activeTab === 'nilai' ? 'active' : '' %>">Kelola Nilai</a>
                <a href="/transkrip" class="<%= activeTab === 'transkrip' ? 'active' : '' %>">Transkrip Nilai</a>
                <a href="/perpustakaan" class="<%= activeTab === 'perpustakaan' ? 'active' : '' %>">Perpustakaan</a>
                <a href="/jadwal" class="<%= activeTab === 'jadwal' ? 'active' : '' %>">Jadwal Kuliah</a>
                <a href="/tugas" class="active">Tugas</a>
            </div>

            <h1><i style="font-style: normal;">✏️</i> <%= title %></h1>

            <div class="form-container">
                <form action="/edit-tugas/<%= tugas.id %>" method="POST">
                    <div class="form-group">
                        <label for="kode_mk">Mata Kuliah:</label>
                        <select name="kode_mk" id="kode_mk" required>
                            <option value="">-- Pilih Mata Kuliah --</option>
                            <% matakuliah.forEach(mk => { %>
                                <option value="<%= mk.kode_mk %>" <%= tugas.kode_mk === mk.kode_mk ? 'selected' : '' %>><%= mk.kode_mk %> - <%= mk.nama_mk %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="judul">Judul Tugas:</label>
                        <input type="text" name="judul" id="judul" value="<%= tugas.judul %>" placeholder="Masukkan judul tugas" required>
                    </div>

                    <div class="form-group">
                        <label for="deskripsi">Deskripsi Tugas:</label>
                        <textarea name="deskripsi" id="deskripsi" placeholder="Jelaskan tugas yang harus dikerjakan mahasiswa..." required><%= tugas.deskripsi %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="deadline">Deadline:</label>
                        <input type="date" name="deadline" id="deadline" value="<%= new Date(tugas.deadline).toISOString().split('T')[0] %>" required>
                    </div>

                    <div style="margin-top: 20px;">
                        <button type="submit" style="background: #28a745; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer;">Update Tugas</button>
                        <a href="/kelola-tugas" style="background: #6c757d; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; margin-left: 10px;">Batal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>