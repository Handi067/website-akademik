<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Tambah Mata Kuliah</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="main-content">
        <div class="container">
            <div class="page-header">
                <div class="title-wrap">
                    <h1>Tambah Mata Kuliah</h1>
                    <div class="subtle">Lengkapi data mata kuliah baru, lalu simpan.</div>
                </div>
                <div class="header-actions" style="margin: 0;">
                    <a href="/mk-postgres" class="home-link">Kembali</a>
                </div>
            </div>

            <div class="form-card">
                <form action="/tambah-mk" method="POST">
                    <div class="form-grid">
                        <div>
                            <label for="kode_mk">Kode Mata Kuliah</label>
                            <input type="text" id="kode_mk" name="kode_mk" required maxlength="10" placeholder="Contoh: SI101">
                        </div>

                        <div>
                            <label for="sks">SKS</label>
                            <input type="number" id="sks" name="sks" required min="1" placeholder="Contoh: 3">
                        </div>

                        <div class="full">
                            <label for="nama_mk">Nama Mata Kuliah</label>
                            <input type="text" id="nama_mk" name="nama_mk" required maxlength="100" placeholder="Contoh: Basis Data">
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/mk-postgres" class="home-link">Batal</a>
                        <button type="submit" class="form-submit-btn">Simpan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>