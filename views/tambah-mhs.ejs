<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Tambah Mahasiswa Baru</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="main-content">
        <div class="container">
            <div class="page-header">
                <div class="title-wrap">
                    <h1>Tambah Mahasiswa</h1>
                    <div class="subtle">Lengkapi data mahasiswa baru, lalu simpan.</div>
                </div>
            </div>

            <div class="setting-layout">
                <div class="setting-sidebar">
                    <h3>DATA UTAMA</h3>
                    <a href="/mk-postgres">Mata Kuliah</a>
                    <a href="/mahasiswa-crud" class="active">Data Mahasiswa</a>
                    
                    <h3 style="margin-top: 20px;">AKSI CEPAT</h3>
                    <a href="/tambah-mhs" style="color: #28a745;" class="active">Tambah Mahasiswa</a>
                    <a href="/" style="color: #6c757d;">Kembali ke Dashboard</a>
                </div>

                <div class="setting-content">
                    <h2>Formulir Data Mahasiswa Baru</h2>
                    
                    <form action="/tambah-mhs" method="POST">
                        <div class="form-grid">
                            <div>
                                <label for="nim">NIM</label>
                                <input type="text" id="nim" name="nim" required maxlength="15" placeholder="Nomor Induk Mahasiswa">
                            </div>

                            <div>
                                <label for="jurusan">Jurusan</label>
                                <input type="text" id="jurusan" name="jurusan" required maxlength="50" placeholder="Contoh: Teknik Informatika">
                            </div>

                            <div class="full">
                                <label for="nama_mhs">Nama Mahasiswa</label>
                                <input type="text" id="nama_mhs" name="nama_mhs" required maxlength="100" placeholder="Nama Lengkap">
                            </div>
                        </div>

                        <div class="form-actions">
                            <a href="/mahasiswa-crud" class="home-link">Batal</a>
                            <button type="submit" class="form-submit-btn">Simpan</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>