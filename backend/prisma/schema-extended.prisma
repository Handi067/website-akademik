// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(MAHASISWA)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  mahasiswa    Mahasiswa?
  dosen        Dosen?
  notifikasi   Notifikasi[]
  auditLogs    AuditLog[]
  pembayaranUKT PembayaranUKT[]
  bimbingan    Bimbingan[]

  @@map("users")
}

model Mahasiswa {
  nim              String   @id @db.VarChar(20)
  userId           String   @unique @map("user_id") @db.Uuid
  namaMhs         String   @map("nama_mhs") @db.VarChar(100)
  jurusan         String   @db.VarChar(50)
  angkatan        String   @db.VarChar(10)
  noHp            String?  @map("no_hp") @db.VarChar(15)
  alamat          String?  @db.Text
  ipk             Decimal?  @db.Decimal(3, 2) @default(0.00)
  totalSks        Int      @default(0) @map("total_sks")
  statusAkademik  String   @default("AKTIF") @map("status_akademik") @db.VarChar(20)
  tahunMasuk      Int      @map("tahun_masuk")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  krs              Krs[]
  nilai            Nilai[]
  absensi          Absensi[]
  peminjaman       Peminjaman[]
  bimbingan        Bimbingan[]
  earlyWarning     EarlyWarning[]
  pembayaranUKT     PembayaranUKT[]

  @@index([nim])
  @@index([userId])
  @@index([jurusan])
  @@index([angkatan])
  @@map("mahasiswa")
}

model Dosen {
  nidn           String   @id @db.VarChar(20)
  userId         String   @unique @map("user_id") @db.Uuid
  namaDosen      String   @map("nama_dosen") @db.VarChar(100)
  gelarDepan     String?  @map("gelar_depan") @db.VarChar(20)
  gelarBelakang  String?  @map("gelar_belakang") @db.VarChar(50)
  email          String?  @db.VarChar(100)
  noHp           String?  @map("no_hp") @db.VarChar(15)
  departemen     String?  @db.VarChar(50)
  nip            String?  @db.VarChar(20)
  nidnKemenristek String?  @map("nidn_kemenristek") @db.VarChar(20)
  status         String   @default("AKTIF") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jadwalKuliah  JadwalKuliah[]
  pertemuan     Pertemuan[]
  bimbingan     Bimbingan[]
  kurikulum      Kurikulum[]

  @@index([nidn])
  @@index([userId])
  @@map("dosen")
}

model Kurikulum {
  id              String   @id @default(uuid())
  kodeKurikulum   String   @unique @map("kode_kurikulum") @db.VarChar(20)
  namaKurikulum   String   @map("nama_kurikulum") @db.VarChar(100)
  tahunAkademik   String   @map("tahun_akademik") @db.VarChar(10)
  totalSks        Int      @map("total_sks") @default(144)
  deskripsi       String?  @db.Text
  status          String   @default("AKTIF") @db.VarChar(20)
  nidnKaprodi     String?  @map("nidn_kaprodi") @db.VarChar(20)
  tanggalMulai    DateTime @map("tanggal_mulai")
  tanggalSelesai   DateTime? @map("tanggal_selesai")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  nidnKaprodi     Dosen?           @relation("KaprodiKurikulum", fields: [nidnKaprodi], references: [nidn])
  dosen           Dosen[]          @relation("DosenKurikulum")
  mataKuliah      MataKuliah[]
  kurikulumMk     KurikulumMk[]

  @@index([kodeKurikulum])
  @@index([tahunAkademik])
  @@map("kurikulum")
}

model KurikulumMk {
  id              String   @id @default(uuid())
  kurikulumId     String   @map("kurikulum_id") @db.Uuid
  kodeMk          String   @map("kode_mk") @db.VarChar(10)
  semester        Int
  jenis           String   @db.VarChar(20) // WAJIB, PILIHAN, MATA KULIAH UMUM
  status          String   @default("AKTIF") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  kurikulum       Kurikulum    @relation(fields: [kurikulumId], references: [id], onDelete: Cascade)
  mataKuliah     MataKuliah  @relation(fields: [kodeMk], references: [kodeMk], onDelete: Cascade)

  @@unique([kurikulumId, kodeMk])
  @@map("kurikulum_mk")
}

model MataKuliah {
  kodeMK         String    @id @map("kode_mk") @db.VarChar(10)
  namaMk         String    @map("nama_mk") @db.VarChar(100)
  sks            Int
  semester        String    @db.VarChar(20)
  deskripsi       String?   @db.Text
  kodePrasyarat  String?   @map("kode_prasyarat") @db.VarChar(10)
  jenis           String    @default("WAJIB") @db.VarChar(20) // WAJIB, PILIHAN, MATA KULIAH UMUM
  status          String    @default("AKTIF") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  jadwalKuliah   JadwalKuliah[]
  nilai           Nilai[]
  pertemuan      Pertemuan[]
  prasyaratFor   MataKuliah? @relation("Prerequisite", fields: [kodePrasyarat], references: [kodeMK])
  prasyarat      MataKuliah[] @relation("Prerequisite")
  kurikulum      KurikulumMk[]

  @@index([kodeMK])
  @@map("matakuliah")
}

model JadwalKuliah {
  id           String   @id @default(uuid())
  kodeMk       String   @map("kode_mk") @db.VarChar(10)
  nidn         String   @db.VarChar(20)
  hari         Hari
  jamMulai     String   @map("jam_mulai") @db.Time
  jamSelesai   String   @map("jam_selesai") @db.Time
  ruangan      String   @db.VarChar(20)
  kelas        String?  @db.VarChar(20)
  semester     String   @db.VarChar(20)
  tahunAjaran  String   @map("tahun_ajaran") @db.VarChar(10)
  kapasitas    Int      @default(40)
  kuota         Int      @default(0)
  status        String   @default("AKTIF") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  matakuliah   Matakuliah @relation(fields: [kodeMk], references: [kodeMK], onDelete: Cascade)
  dosen        Dosen      @relation(fields: [nidn], references: [nidn], onDelete: Cascade)
  krs          Krs[]
  pertemuan    Pertemuan[]

  @@index([kodeMk])
  @@index([nidn])
  @@index([semester, tahunAjaran])
  @@map("jadwal_kuliah")
}

model Krs {
  id           String      @id @default(uuid())
  nim          String      @db.VarChar(20)
  jadwalId     String      @map("jadwal_id") @db.Uuid
  semester     String      @db.VarChar(20)
  tahunAjaran  String      @map("tahun_ajaran") @db.VarChar(10)
  status       KrsStatus   @default(AKTIF)
  isApproved    Boolean     @default(false) @map("is_approved")
  approvedBy    String?     @map("approved_by") @db.Uuid
  approvedAt    DateTime?   @map("approved_at")
  catatan      String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  mahasiswa    Mahasiswa   @relation(fields: [nim], references: [nim], onDelete: Cascade)
  jadwalKuliah JadwalKuliah @relation(fields: [jadwalId], references: [id], onDelete: Cascade)
  approvedUser  User?       @relation("KrsApproval", fields: [approvedBy], references: [id])

  @@unique([nim, jadwalId, semester, tahunAjaran])
  @@index([nim])
  @@index([jadwalId])
  @@index([semester, tahunAjaran])
  @@map("krs")
}

model Nilai {
  id           String   @id @default(uuid())
  nim          String   @db.VarChar(20)
  kodeMk       String   @map("kode_mk") @db.VarChar(10)
  tugas        Decimal? @db.Decimal(5, 2)
  uts          Decimal? @db.Decimal(5, 2)
  uas          Decimal? @db.Decimal(5, 2)
  nilaiAkhir   Decimal? @map("nilai_akhir") @db.Decimal(5, 2)
  grade        Grade?   @db.VarChar(2)
  bobot        Decimal? @db.Decimal(3, 2)
  semester     String   @db.VarChar(20)
  tahunAjaran  String   @map("tahun_ajaran") @db.VarChar(10)
  isLocked     Boolean  @default(false) @map("is_locked")
  lockedBy     String?  @map("locked_by") @db.Uuid
  lockedAt     DateTime? @map("locked_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  mahasiswa    Mahasiswa @relation(fields: [nim], references: [nim], onDelete: Cascade)
  matakuliah   MataKuliah @relation(fields: [kodeMk], references: [kodeMK], onDelete: Cascade)
  lockedUser   User?      @relation("NilaiLocking", fields: [lockedBy], references: [id])

  @@unique([nim, kodeMk, semester, tahunAjaran])
  @@index([nim])
  @@index([kodeMk])
  @@map("nilai")
}

model Pertemuan {
  id           String   @id @default(uuid())
  kodeMk       String   @map("kode_mk") @db.VarChar(10)
  nidn         String   @db.VarChar(20)
  pertemuanKe  Int      @map("pertemuan_ke")
  tanggal       DateTime @db.Date
  topik        String?  @db.VarChar(200)
  materi       String?  @db.Text
  linkOnline    String?  @map("link_online") @db.Text
  status        String   @default("TERJADWAL") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  matakuliah   MataKuliah @relation(fields: [kodeMk], references: [kodeMK], onDelete: Cascade)
  dosen        Dosen      @relation(fields: [nidn], references: [nidn], onDelete: Cascade)
  absensi      Absensi[]

  @@map("pertemuan")
}

model Absensi {
  id           String      @id @default(uuid())
  pertemuanId  String      @map("pertemuan_id") @db.Uuid
  nim          String      @db.VarChar(20)
  statusHadir  StatusHadir @map("status_hadir")
  jamMasuk     DateTime?   @map("jam_masuk") @db.Time
  jamKeluar    DateTime?   @map("jam_keluar") @db.Time
  keterangan   String?     @db.Text
  lokasi       String?     @db.VarChar(100)
  deviceInfo   String?     @map("device_info") @db.Text
  ipAddress    String?     @map("ip_address") @db.Inet
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  pertemuan    Pertemuan @relation(fields: [pertemuanId], references: [id], onDelete: Cascade)
  mahasiswa    Mahasiswa @relation(fields: [nim], references: [nim], onDelete: Cascade)

  @@unique([pertemuanId, nim])
  @@index([pertemuanId])
  @@index([nim])
  @@map("absensi")
}

model PembayaranUKT {
  id              String   @id @default(uuid())
  nim             String   @db.VarChar(20)
  tahunAkademik   String   @map("tahun_akademik") @db.VarChar(10)
  semester        String   @db.VarChar(20)
  jumlah          Decimal  @db.Decimal(12, 2)
  jumlahDibayar   Decimal? @map("jumlah_dibayar") @db.Decimal(12, 2)
  status          PembayaranStatus @default(BELUM_BAYAR)
  metodePembayaran String?  @map("metode_pembayaran") @db.VarChar(50)
  noReferensi     String?  @map("no_referensi") @db.VarChar(100)
  tanggalBayar    DateTime? @map("tanggal_bayar")
  buktiPembayaran String?  @map("bukti_pembayaran") @db.Text
  verifiedBy      String?  @map("verified_by") @db.Uuid
  verifiedAt      DateTime? @map("verified_at")
  catatan         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  mahasiswa      Mahasiswa @relation(fields: [nim], references: [nim], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedUser   User?     @relation("PembayaranVerification", fields: [verifiedBy], references: [id])

  @@index([nim])
  @@index([tahunAkademik, semester])
  @@index([status])
  @@map("pembayaran_ukt")
}

model EarlyWarning {
  id              String   @id @default(uuid())
  nim             String   @db.VarChar(20)
  jenisWarning     String   @map("jenis_warning") @db.VarChar(50) // IPK, ABSENSI, SKS, NILAI
  level           String   @db.VarChar(20) // RENDAH, SEDANG, TINGGI, KRITIS
  threshold       Decimal  @db.Decimal(5, 2)
  currentValue    Decimal  @map("current_value") @db.Decimal(5, 2)
  pesan          String   @db.Text
  status          String   @default("AKTIF") @db.VarChar(20) // AKTIF, DITANGANI, SELESAI
  notifikasiSent  Boolean  @default(false) @map("notifikasi_sent")
  handledBy       String?  @map("handled_by") @db.Uuid
  handledAt       DateTime? @map("handled_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  mahasiswa      Mahasiswa @relation(fields: [nim], references: [nim], onDelete: Cascade)
  handledUser    User?     @relation("WarningHandling", fields: [handledBy], references: [id])

  @@index([nim])
  @@index([jenisWarning])
  @@index([status])
  @@map("early_warning")
}

model Bimbingan {
  id              String   @id @default(uuid())
  nim             String   @db.VarChar(20)
  nidnPembimbing  String   @map("nidn_pembimbing") @db.VarChar(20)
  semester        String   @db.VarChar(20)
  tahunAkademik   String   @map("tahun_akademik") @db.VarChar(10)
  status          String   @default("AKTIF") @db.VarChar(20)
  catatan         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  mahasiswa       Mahasiswa @relation(fields: [nim], references: [nim], onDelete: Cascade)
  pembimbing      Dosen      @relation(fields: [nidnPembimbing], references: [nidn], onDelete: Cascade)

  @@unique([nim, nidnPembimbing, semester, tahunAkademik])
  @@index([nim])
  @@index([nidnPembimbing])
  @@map("bimbingan")
}

model Notifikasi {
  id        String           @id @default(uuid())
  userId    String           @map("user_id") @db.Uuid
  judul     String           @db.VarChar(200)
  pesan     String           @db.Text
  tipe      NotifikasiTipe   @default(INFO)
  isRead    Boolean          @default(false) @map("is_read")
  priority  String           @default("NORMAL") @db.VarChar(20) // LOW, NORMAL, HIGH, URGENT
  data      Json?            // Additional data for notifications
  createdAt DateTime         @default(now()) @map("created_at")
  readAt    DateTime?        @map("read_at")

  // Relations
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([tipe])
  @@map("notifikasi")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id") @db.Uuid
  aksi      String   @db.VarChar(50)
  tabel     String   @db.VarChar(50)
  recordId  String?  @map("record_id") @db.VarChar(50)
  dataLama  Json?    @map("data_lama")
  dataBaru  Json?    @map("data_baru")
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tabel])
  @@index([createdAt])
  @@map("audit_log")
}

model Buku {
  kodeBuku   String   @id @map("kode_buku") @db.VarChar(20)
  judul      String   @db.VarChar(200)
  pengarang  String   @db.VarChar(100)
  penerbit   String   @db.VarChar(100)
  tahun       Int
  isbn        String?  @db.VarChar(20)
  kategori    String   @db.VarChar(50)
  jumlah      Int      @default(1)
  tersedia    Int      @default(1)
  lokasi      String?  @db.VarChar(100)
  deskripsi   String?  @db.Text
  qrCode      String?  @map("qr_code") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  peminjaman Peminjaman[]

  @@index([kodeBuku])
  @@map("buku")
}

model Peminjaman {
  id             String           @id @default(uuid())
  kodeBuku       String           @map("kode_buku") @db.VarChar(20)
  nim            String           @db.VarChar(20)
  tanggalPinjam   DateTime         @map("tanggal_pinjam") @db.Date
  tanggalKembali  DateTime?        @map("tanggal_kembali") @db.Date
  tenggat        DateTime         @db.Date
  status         PeminjamanStatus @default(AKTIF)
  denda          Decimal          @default(0) @db.Decimal(10, 2)
  perpanjangan   Int              @default(0)
  catatan        String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // Relations
  buku           Buku      @relation(fields: [kodeBuku], references: [kodeBuku], onDelete: Cascade)
  mahasiswa      Mahasiswa  @relation(fields: [nim], references: [nim], onDelete: Cascade)

  @@index([kodeBuku])
  @@index([nim])
  @@index([status])
  @@map("peminjaman")
}

model DigitalSignature {
  id            String   @id @default(uuid())
  userId        String   @map("user_id") @db.Uuid
  documentType  String   @map("document_type") @db.VarChar(50) // KHS, IJAZAH, TRANSKRIP, etc.
  documentId    String   @map("document_id") @db.VarChar(100)
  signature     String   @db.Text
  qrCode        String   @map("qr_code") @db.VarChar(500)
  isValid       Boolean  @default(true) @map("is_valid")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  verifiedAt    DateTime? @map("verified_at")

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@index([expiresAt])
  @@map("digital_signature")
}

// Enums
enum Role {
  ADMIN
  DOSEN
  MAHASISWA
}

enum Hari {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
  MINGGU
}

enum KrsStatus {
  AKTIF
  BATAL
  SELESAI
  DITOLAK
}

enum Grade {
  A
  B_PLUS
  B
  C_PLUS
  C
  D
  E
}

enum StatusHadir {
  HADIR
  IZIN
  SAKIT
  ALPA
}

enum NotifikasiTipe {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum PeminjamanStatus {
  AKTIF
  DIKEMBALIKAN
  TERLAMBAT
  HILANG
}

enum PembayaranStatus {
  BELUM_BAYAR
  MENUNGGU_VERIFIKASI
  SUDAH_BAYAR
  DITOLAK
  DIBATALKAN
}
